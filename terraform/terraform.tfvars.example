# Copy to terraform.tfvars and fill in real values.
# terraform.tfvars is gitignored - never commit it.

db_password          = "change-me-to-a-strong-password"
firebase_project_id  = "your-firebase-project-id"

# Optional: set to an existing EC2 key pair name to allow SSH access.
# Leave blank ("") to rely on SSM Session Manager only (recommended).
# ssh_key_name = "my-keypair"
